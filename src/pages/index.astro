---
import Layout from "@/layouts/main.astro"
import Seal from "@/components/Seal.astro"

const github = "https://github.com/yukazakiri/koakademy"
---

<Layout>
  <!-- ============================== NAV ============================== -->
  <header class="site-nav sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md">
    <nav class="mx-auto max-w-6xl px-6" aria-label="Main">
      <div class="flex h-16 items-center justify-between">
      <a href="#top" class="flex items-center gap-2.5">
        <Seal size={28} class="text-ink" />
        <span class="font-display text-[19px] font-medium tracking-[-0.01em]">KoAkademy</span>
        <span
          class="ml-1 rounded border border-line px-1.5 py-px font-mono text-[9.5px] uppercase tracking-[0.18em] text-ink-soft"
          >Beta</span
        >
      </a>

      <div class="hidden items-center gap-7 text-[14px] text-ink-soft md:flex">
        <a href="#platform" class="transition-colors hover:text-ink">Platform</a>
        <a href="#enrollment" class="transition-colors hover:text-ink">Enrollment</a>
        <a href="#portals" class="transition-colors hover:text-ink">Portals</a>
        <a href="#stack" class="transition-colors hover:text-ink">Stack</a>
        <a href="/docs" class="transition-colors hover:text-ink">Docs</a>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href={github}
          target="_blank"
          rel="noreferrer"
          class="hidden items-center gap-2 rounded-lg border border-line px-3.5 py-2.5 text-[13.5px] font-medium text-ink transition-colors hover:border-ink/30 hover:bg-paper-2 sm:inline-flex"
        >
          <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          GitHub
        </a>
        <a
          href="#install"
          class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-2.5 text-[13.5px] font-medium text-paper transition hover:-translate-y-px hover:bg-ink/85"
        >
          Install
          <svg
            viewBox="0 0 24 24"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
      </div>
      <div
        class="flex items-center justify-center gap-6 border-t border-line py-2 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-soft md:hidden"
      >
        <a href="#platform" class="transition-colors hover:text-ink">Platform</a>
        <a href="#enrollment" class="transition-colors hover:text-ink">Enrollment</a>
        <a href="#portals" class="transition-colors hover:text-ink">Portals</a>
        <a href="#stack" class="transition-colors hover:text-ink">Stack</a>
        <a href="/docs" class="transition-colors hover:text-ink">Docs</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- ============================== HERO ============================== -->
    <section class="relative overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-[560px] bg-[radial-gradient(55%_50%_at_50%_0%,rgba(163,123,38,0.10),transparent_70%)]"
      ></div>

      <div class="mx-auto max-w-6xl px-6 pb-14 pt-16 md:pb-20 md:pt-24">
        <div class="grid items-center gap-14 lg:grid-cols-[1.08fr_1fr] lg:gap-16">
          <div class="max-w-xl text-left">
          <p
            class="reveal font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-brass-deep"
          >
            Open source · Self-hosted · AGPL-3.0
          </p>

          <h1
            class="reveal opsz-72 mt-6 font-display text-balance text-[clamp(2.35rem,4.8vw,4rem)] font-medium leading-[1.06] tracking-[-0.015em]"
            style="--d:90ms"
          >
            The school’s system of record,
            <em class="italic text-brass-deep">owned by the school.</em>
          </h1>

          <p
            class="reveal mt-6 max-w-md text-[16.5px] leading-relaxed text-ink-soft"
            style="--d:180ms"
          >
            KoAkademy is a complete academic management platform — enrollment,
            academics, finance, and three portals — that runs on infrastructure
            you choose. No per-student pricing. No feature gates.
          </p>

          <div
            class="reveal mt-9 flex flex-wrap items-center gap-3.5"
            style="--d:270ms"
          >
            <a
              href="#install"
              class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-3 text-[14px] font-medium text-paper shadow-[0_12px_28px_-16px_rgba(26,42,33,0.5)] transition hover:-translate-y-px hover:bg-ink/85"
            >
              Get started
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a
              href="/docs"
              class="inline-flex items-center gap-2 rounded-lg border border-ink/15 bg-paper-2/70 px-5 py-3 text-[14px] font-medium text-ink transition-colors hover:border-ink/30 hover:bg-paper-2"
            >
              Read the docs
            </a>
          </div>

          <p
            class="reveal mt-6 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft"
            style="--d:360ms"
          >
            No per-student pricing. No feature gates. Seriously.
          </p>
          </div>

          <!-- Angled dashboard showcase -->
          <div
            class="reveal relative mx-auto mt-16 w-full max-w-xl lg:mt-0 lg:max-w-none"
            style="--d:420ms"
          >
          <div class="hero-dashboard relative">
            <div
              aria-hidden="true"
              class="hero-dashboard-back absolute inset-0 rounded-xl border border-line bg-paper-2"
            ></div>

            <Seal
              size={200}
              class="pointer-events-none absolute -left-10 -top-12 -rotate-6 text-ink opacity-[0.05]"
            />

          <div
            class="absolute -top-4 right-2 z-10 flex items-center gap-2 rounded-md border border-brass/30 bg-paper px-3 py-1.5 text-[10.5px] font-medium uppercase tracking-[0.14em] text-brass-deep shadow-[0_10px_24px_-16px_rgba(26,42,33,0.45)] md:right-6"
          >
            <span
              class="size-1.5 rounded-full bg-brass"
              style="animation: kd-pulse 2s ease-in-out infinite"
            ></span>
            Self-hosted · live
          </div>

          <div
            class="absolute -bottom-4 left-2 z-10 hidden items-center gap-2 rounded-md border border-line bg-paper px-3 py-1.5 text-[11px] font-medium tracking-[0.06em] text-ink-soft shadow-[0_10px_24px_-16px_rgba(26,42,33,0.4)] md:left-6 md:flex"
          >
            <svg
              viewBox="0 0 24 24"
              width="12"
              height="12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="4.5" y="10.5" width="15" height="9.5" rx="1.5" />
              <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
            </svg>
            MFA · passkeys · RBAC
          </div>

            <div
              class="hero-dashboard-panel group relative overflow-hidden rounded-xl border border-line bg-paper"
            >
            <div
              class="grid grid-cols-[1fr_auto_1fr] items-center border-b border-line px-4 py-2"
            >
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="size-2 rounded-full bg-line"></span>
                <span class="size-2 rounded-full bg-line"></span>
                <span class="size-2 rounded-full bg-line"></span>
              </div>
              <span
                class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-soft"
                >koakademy · admin</span
              >
              <span
                class="flex items-center justify-end gap-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-brass-deep"
              >
                <span class="size-1.5 rounded-full bg-brass"></span>
                live
              </span>
            </div>
            <img
              src="/screenshots/admin-dashboard.png"
              width="1440"
              height="1000"
              fetchpriority="high"
              alt="KoAkademy administrator dashboard — the school's full register in one view"
              class="aspect-[1440/1000] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
            />
            </div>
            </div>
          </div>

          <!-- Logo banner -->
          <div class="mt-16 border-t border-line pt-8 md:mt-20">
            <p
              class="text-center font-mono text-[10.5px] font-medium uppercase tracking-[0.22em] text-ink-soft"
            >
              Runs on infrastructure you choose
            </p>
            <ul
              class="mt-6 flex flex-wrap items-center justify-center gap-x-9 gap-y-3 font-display text-[17px] font-medium tracking-[-0.01em] text-ink-soft"
            >
              <li class="transition-colors hover:text-ink">Laravel</li>
              <li class="transition-colors hover:text-ink">PostgreSQL</li>
              <li class="transition-colors hover:text-ink">Redis</li>
              <li class="transition-colors hover:text-ink">React</li>
              <li class="transition-colors hover:text-ink">FrankenPHP</li>
              <li class="transition-colors hover:text-ink">Docker</li>
              <li class="transition-colors hover:text-ink">S3</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== INSTALL ============================== -->
    <section id="install" class="scroll-mt-20 border-b border-line bg-paper-2/40">
      <div
        class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-16 md:py-20 lg:grid-cols-[1fr_1.45fr] lg:gap-14"
      >
        <div class="reveal">
          <p
            class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-brass-deep"
          >
            Install
          </p>
          <h2
            class="opsz-40 mt-4 font-display text-balance text-[clamp(1.9rem,3.5vw,2.6rem)] font-medium leading-[1.1] tracking-[-0.01em]"
          >
            Up and running in one command.
          </h2>
          <p class="mt-5 max-w-md text-[15.5px] leading-relaxed text-ink-soft">
            The installer provisions PostgreSQL, Redis, FrankenPHP, and the
            application itself. A one-time /setup URL walks you through the rest —
            no account, no phone-home.
          </p>
          <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-soft">
            One-line installer · one-time /setup URL · no account required
          </p>
        </div>

        <div class="reveal" style="--d:120ms">
          <div
            class="install-card overflow-hidden rounded-xl border border-ink/15 bg-[#14211a] text-[#e9ebdf] shadow-[0_24px_44px_-32px_rgba(26,42,33,0.55)]"
          >
            <div
              class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-2.5"
            >
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="size-2 rounded-full bg-white/15"></span>
                <span class="size-2 rounded-full bg-white/15"></span>
                <span class="size-2 rounded-full bg-white/15"></span>
              </div>
              <div
                class="flex items-center gap-0.5 rounded-lg bg-white/5 p-0.5"
                role="group"
                aria-label="Choose your operating system"
              >
                <button
                  type="button"
                  id="install-tab-linux"
                  aria-pressed="true"
                  data-os="linux"
                  class="install-tab install-tab-active rounded-md px-2.5 py-1 font-mono text-[10.5px] font-medium uppercase tracking-[0.14em] text-[#9aa79e] transition-colors hover:text-[#e9ebdf]"
                >
                  Linux / macOS
                </button>
                <button
                  type="button"
                  id="install-tab-windows"
                  aria-pressed="false"
                  data-os="windows"
                  class="install-tab rounded-md px-2.5 py-1 font-mono text-[10.5px] font-medium uppercase tracking-[0.14em] text-[#9aa79e] transition-colors hover:text-[#e9ebdf]"
                >
                  Windows
                </button>
              </div>
            </div>

            <div class="relative px-4 py-3.5">
              <button
                type="button"
                class="install-copy absolute right-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-md border border-white/15 bg-[#1d2f26] px-2 py-1 font-mono text-[9.5px] font-semibold uppercase tracking-[0.14em] text-[#c9a44c] transition-colors hover:border-[#c9a44c]/60 hover:text-[#e9ebdf]"
                aria-label="Copy the install command"
              >
                Copy
              </button>

              <div id="install-panel-linux" class="install-panel">
                <pre
                  class="overflow-x-auto whitespace-nowrap pr-16 text-left font-mono text-[12.5px] leading-relaxed"
                  ><code class="language-bash">bash -c "$(curl -fsSL https://raw.githubusercontent.com/yukazakiri/koakademy/master/scripts/install.sh)"</code></pre
                >
              </div>
              <div id="install-panel-windows" class="install-panel" hidden>
                <pre
                  class="overflow-x-auto whitespace-nowrap pr-16 text-left font-mono text-[12.5px] leading-relaxed"
                  ><code class="language-powershell">&amp; ([scriptblock]::Create((irm https://raw.githubusercontent.com/yukazakiri/koakademy/master/scripts/install.ps1)))</code></pre
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== CLAIMS ============================== -->
    <section class="border-b border-line bg-paper-2/50">
      <div
        class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 md:py-16 lg:grid-cols-4 lg:gap-0"
      >
        <div class="lg:pr-8">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-brass"></span>
          <h3 class="mt-3.5 text-[15px] font-semibold tracking-[-0.01em]">
            No per-student pricing
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink-soft">
            One image runs the whole school.
          </p>
        </div>
        <div class="lg:border-l lg:border-line lg:px-8">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-brass"></span>
          <h3 class="mt-3.5 text-[15px] font-semibold tracking-[-0.01em]">
            No feature gates
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink-soft">
            Enrollment, finance, portals — included, not upsold.
          </p>
        </div>
        <div class="lg:border-l lg:border-line lg:px-8">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-brass"></span>
          <h3 class="mt-3.5 text-[15px] font-semibold tracking-[-0.01em]">
            Your data, your backups
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink-soft">
            PostgreSQL and object storage you control.
          </p>
        </div>
        <div class="lg:border-l lg:border-line lg:pl-8">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-brass"></span>
          <h3 class="mt-3.5 text-[15px] font-semibold tracking-[-0.01em]">
            AGPL-3.0, forever
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink-soft">
            The system of record stays open.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================== PLATFORM ============================== -->
    <section id="platform" class="scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <div class="reveal max-w-2xl">
          <p
            class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-brass-deep"
          >
            The platform
          </p>
          <h2
            class="opsz-40 mt-4 font-display text-balance text-[clamp(2rem,4vw,2.9rem)] font-medium leading-[1.1] tracking-[-0.01em]"
          >
            Everything a school runs on, in one repository.
          </h2>
          <p class="mt-5 max-w-xl text-[15.5px] leading-relaxed text-ink-soft">
            KoAkademy is built around the daily work of a school — not a generic
            database with education fields added later.
          </p>
        </div>

        <div
          class="reveal mt-14 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2 lg:grid-cols-3"
          style="--d:120ms"
        >
          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 21h18" />
                <path d="M5.5 21V11h13v10" />
                <path d="M5.5 11V8l-1.5 1L12 3l8 6-1.5-1v3" />
              </svg>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">Administration</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">
              Students, faculty, programs, courses, classrooms, terms, schedules,
              attendance, grading, and institution branding in one register.
            </p>
          </article>

          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 3.5h8l4 4V20.5H6z" />
                <path d="M14 3.5v4h4" />
                <path d="m9.5 13.5 2 2 3.5-3.5" />
              </svg>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">
              Enrollment engine
            </h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">
              A registrar-to-cashier workflow driven by versioned blueprints. Rules
              can be scoped, simulated, staged, and rolled back — never buried in code.
            </p>
          </article>

          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="9" cy="8.5" r="2.75" />
                <path d="M4.5 19.5c.4-3.1 2.3-4.5 4.5-4.5s4.1 1.4 4.5 4.5" />
                <circle cx="16.5" cy="9.5" r="2.25" />
                <path d="M15.3 15.2c2.8.2 4.4 1.7 4.7 4.3" />
              </svg>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">Three portals</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">
              Distinct administrator, faculty, and student experiences for the work
              each role actually does: classes, attendance, grades, tuition, and
              digital IDs.
            </p>
          </article>

          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 3.5h12V20.5l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5z" />
                <path d="M9.5 8.5h5M9.5 12h5M9.5 15.5h3" />
              </svg>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">Finance</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">
              Tuition assessment, payment posting, statements of account, receipts,
              public verification, and finance reporting — without exporting records
              to another product.
            </p>
          </article>

          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z" />
                <path d="m4 7.5 8 4.5 8-4.5" />
                <path d="M12 12v9" />
              </svg>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">
              Optional modules
            </h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">
              Library, inventory, cashier, student medical records, announcements,
              and notifications — enabled as the institution needs them.
            </p>
          </article>

          <article class="group bg-paper p-7 transition-colors duration-300 hover:bg-paper-2">
            <div
              class="flex size-10 items-center justify-center rounded-md border border-line text-ink transition-colors duration-300 group-hover:border-brass/40 group-hover:text-brass-deep"
            >
              <svg
