</Layout>  <script>
    import { copyToClipboard, flashCopied } from "@/lib/clipboard"

    const nav = document.querySelector(".site-nav")
    const onScroll = () => {
      if (nav) nav.classList.toggle("scrolled", window.scrollY > 4)
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    onScroll()

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible")
            io.unobserve(entry.target)
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    )
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el))

    // --- Install command tabs & copy ---
    /** @type {HTMLButtonElement[]} */
    const installTabs = [...document.querySelectorAll(".install-tab")]
    /** @type {HTMLButtonElement | null} */
    const installCopy = document.querySelector(".install-copy")
    /** @type {HTMLElement[]} */
    const installPanels = [...document.querySelectorAll(".install-panel")]

    /** @param {string} os */
    const selectOs = (os) => {
      for (const tab of installTabs) {
        const active = tab.dataset.os === os
        tab.setAttribute("aria-pressed", String(active))
        tab.classList.toggle("install-tab-active", active)
      }
      for (const panel of installPanels) {
        panel.hidden = panel.id !== `install-panel-${os}`
      }
    }

    for (const tab of installTabs) {
      tab.addEventListener("click", () => selectOs(tab.dataset.os || "linux"))
    }

    if (installCopy) {
      installCopy.addEventListener("click", async () => {
        const visible = installPanels.find((p) => !p.hidden)
        /** @type {HTMLElement | null} */
        const code = visible ? visible.querySelector("code") : null
        const text = (code && code.innerText) || ""
        if (!text) return
        if (await copyToClipboard(text)) flashCopied(installCopy)
      })
    }
  </script>
