---
import DocsLayout from "@/layouts/DocsLayout.astro"
import { apiTree } from "@/data/docs"
---

<DocsLayout
  title="API reference"
  path="/api"
  section="api"
  description="The tested, documented integration surface for KoAkademy."
>
  <h2>Pick a page</h2>
  <p>
    The API reference documents the beta integration surface: the routes covered
    by endpoint tests and the stability contract around them. Routes not listed
    here are internal and may change without notice.
  </p>

  <div
    class="mt-8 grid gap-6 sm:grid-cols-2"
    style="display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))"
  >
    {
      apiTree.map((group) => (
        <div class="rounded-xl border border-line bg-paper p-6">
          <p class="font-mono text-[11px] font-medium tracking-[0.22em] text-brass-deep uppercase">
            {group.label}
          </p>
          <ul class="mt-4 space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="group/link flex items-start gap-2.5">
                  <span
                    aria-hidden="true"
                    class="mt-[7px] size-1 shrink-0 rotate-45 bg-brass transition-colors group-hover/link:bg-ink"
                  />
                  <span class="min-w-0">
                    <span class="block text-[14.5px] font-medium text-ink transition-colors group-hover/link:text-brass-deep">
                      {link.title}
                    </span>
                    <span class="mt-0.5 block text-[12.5px] leading-relaxed text-ink-soft">
                      {link.blurb}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="doc-callout doc-callout-note">
    <p class="doc-callout-label">Beta stability</p>
    <p>
      KoAkademy's API is beta. Pin the latest stable version, handle the
      documented status codes, and verify integrations in staging before
      upgrading. Start with the <a href="/api/api-overview">API overview</a>.
    </p>
  </div>
</DocsLayout>
