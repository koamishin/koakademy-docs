      </tr>
      <tr>
        <td>Search</td>
        <td>Scout, <code>database</code> driver by default</td>
        <td>Meilisearch optional</td>
      </tr>
      <tr>
        <td>Settings</td>
        <td>Database via spatie/laravel-settings</td>
