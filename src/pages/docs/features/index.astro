import DocsLayout from "@/layouts/DocsLayout.astro"

const html =
  "<p>Koakademy is an open-source, all-in-one educational ERP, student information system (SIS), and learning management platform. It gives private and public educational institutions complete ownership over student records, academic scheduling, enrollment automation, tuition billing, and daily school operations.</p>\n<pre><code>┌────────────────────────────────────────────────────────────────────────┐\n│                        Koakademy Platform                              │\n└──────────────────────────────────┬─────────────────────────────────────┘\n                                   │\n         ┌─────────────────────────┼─────────────────────────┐\n         ▼                         ▼                         ▼\n┌──────────────────┐     ┌──────────────────┐     ┌──────────────────┐\n│ Administrative   │     │ Faculty Portal   │     │ Student Portal   │\n│ Workspace        │     │ (Inertia + React)│     │ (Inertia + React)│\n│ (Filament 5)     │     │                  │     │                  │\n└────────┬─────────┘     └────────┬─────────┘     └────────┬─────────┘\n         │                        │                        │\n         └────────────────────────┼────────────────────────┘\n                                  ▼\n┌────────────────────────────────────────────────────────────────────────┐\n│                     Core Domain Engine &amp; Services                      │\n│                                                                        │\n│  • Student Information System (SIS)  • Academic Curricula &amp; Timetable  │\n│  • Dynamic Enrollment Blueprints     • Multi-Scale Grading &amp; GWA       │\n│  • Automated Tuition &amp; Cashiering    • Six Bundled Specialized Modules │\n│  • Cryptographic Verifications       • AI Assistant &amp; MCP Server       │\n└────────────────────────────────────────────────────────────────────────┘\n</code></pre>\n<h2>Institutional Coverage</h2>\n<p>Koakademy natively accommodates different educational levels and regulatory frameworks within a single deployment or across multiple federated campuses:</p>\n<table>\n<thead>\n<tr>\n<th>Institution Level</th>\n<th>Regulatory Framework</th>\n<th>Specialized Capabilities Included</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>Senior High School (SHS)</strong></td>\n<td>DepEd (K-12)</td>\n<td>Academic &amp; TVL tracks, strands (STEM, ABM, HUMSS, GAS, ICT, HE), strand-specific subject matrices, semester and quarterly terms.</td>\n</tr>\n<tr>\n<td><strong>Colleges &amp; Universities</strong></td>\n<td>CHED</td>\n<td>Degree programs, majors, lecture vs. laboratory credit unit calculations, prerequisites, co-requisites, year levels, Latin honors computation.</td>\n</tr>\n<tr>\n<td><strong>Technical-Vocational</strong></td>\n<td>TESDA / TVET</td>\n<td>Competency-based qualifications, certificate courses, modular training batches, assessment export sheets.</td>\n</tr>\n<tr>\n<td><strong>Multi-School Campus Networks</strong></td>\n<td>Federated Multi-Tenancy</td>\n<td>Isolated school organizations with shared infrastructure, cross-campus role assignments, and instant tenant switching.</td>\n</tr>\n</tbody></table>\n<hr>\n<h2>Feature Matrix</h2>\n<h3>1. Student Lifecycle &amp; Records (SIS)</h3>\n<ul>\n<li><strong>Comprehensive Student Profiles:</strong> Personal details, civil status, PSA birth certificate records, complete Philippine standard geographic code (PSGC) address hierarchies (Region, Province, City/Municipality, Barangay), and contact numbers.</li>\n<li><strong>Family &amp; Guardian Information:</strong> Parent and emergency contact profiles, income tiers, and relationship records.</li>\n<li><strong>Prior Education History:</strong> Historical schools attended, year graduated, LRN (Learner Reference Number), and entrance credentials.</li>\n<li><strong>Digital Student ID Cards:</strong> High-fidelity student identification cards generated server-side with customizable layout, student photo, barcodes, and cryptographically signed QR codes.</li>\n<li><strong>Public &amp; Authenticated Verification:</strong> QR verification endpoints to instantaneously validate enrollment status, student authenticity, and ID validity.</li>\n<li><strong>Student Clearance Workflows:</strong> Departmental clearance sign-offs (Library, Cashier, Clinic, Guidance, Prefect of Discipline) with automated clearance hold restrictions.</li>\n<li><strong>Status History &amp; ID Change Audit:</strong> Immutable historical ledger tracking status changes (Active, Enrolled, LOA, Dropped, Graduated, Expelled) and student number revisions.</li>\n</ul>\n<h3>2. Academics, Curricula &amp; Timetabling</h3>\n<ul>\n<li><strong>Curriculum &amp; Program Builder:</strong> Structured academic programs mapped by year level and semester, complete with lecture units, laboratory units, prerequisite chains, and co-requisites.</li>\n<li><strong>Spreadsheet Imports:</strong> Bulk curriculum ingestion supporting standardized CSV and Excel import templates with validation feedback.</li>\n<li><strong>Class Section Management:</strong> Capacity caps, automatic seat reservation, and section cloning across academic terms.</li>\n<li><strong>Timetable Scheduling &amp; Conflict Detection:</strong> Interactive weekly schedule view with automated conflict prevention across classrooms, faculty loading, and student schedules.</li>\n<li><strong>Facility &amp; Room Allocation:</strong> Building, floor, room capacities, and specialized facility assignments (Computer Labs, Science Labs, Auditoriums).</li>\n<li><strong>Calendar Feeds:</strong> Subscribable iCal and Google Calendar sync for student schedules and faculty timetables.</li>\n</ul>\n<h3>3. Enrollment Blueprints &amp; Automation</h3>\n<ul>\n<li><strong>Guided Blueprint Engine:</strong> Seven-stage guided configuration defining school scopes, availability dates, admission requirements, subject pricing, and approval sequences.</li>\n<li><strong>Dynamic Rule Engine:</strong> Rule evaluation assessing minimum GWA, prerequisite completion, document submissions, and clearance holds without hardcoded logic.</li>\n<li><strong>Lecture vs. Laboratory Pricing:</strong> Automated tuition assessment supporting distinct per-unit lecture rates, lab rates, program fees, and institutional charges.</li>\n<li><strong>Scholarship &amp; Discount System:</strong> Automatic sibling discounts, academic honor discounts, athletic grants, and custom percentage or fixed-amount vouchers.</li>\n<li><strong>Acyclic Approval Workflows:</strong> Configurable multi-step approval paths (Registrar -&gt; Dean -&gt; Cashier -&gt; Enrolled) with conditional branching and fallback reviewers.</li>\n<li><strong>Journey Simulator:</strong> Risk-free policy testing allowing registrars to simulate a sample student journey before activating a policy version.</li>\n<li><strong>Rollout States &amp; Snapshots:</strong> Immutable policy versioning preventing retro-active changes to active enrollments while allowing smooth policy rollbacks.</li>\n</ul>\n<h3>4. Grading, Transcripts &amp; Academic Honors</h3>\n<ul>\n<li><strong>Configurable Grading Policies:</strong> Support for numeric (1.0 to 5.0), percentage (0% to 100%), letter grades (A through F), and Pass/Fail rubrics.</li>\n<li><strong>Grade Submission Periods:</strong> Scheduled grading windows with countdown timers, automated locking, and formal change-of-grade request workflows.</li>\n<li><strong>General Weighted Average (GWA):</strong> Real-time weighted average calculation with configurable rules for including or excluding specific subject categories (e.g. NSTP, PE, Religious Education).</li>\n<li><strong>Official Transcript of Records (TOR):</strong> Server-rendered PDF transcripts with security watermarks, registrar signature blocks, and grade verification hashes.</li>\n</ul>\n<h3>5. Financial Management, Billing &amp; Cashiering</h3>\n<ul>\n<li><strong>Tuition Fee Assessment:</strong> Automated tuition computation upon subject selection, itemizing tuition, miscellaneous fees, and laboratory charges.</li>\n<li><strong>Installment Payment Schemes:</strong> Configurable payment plans (Full cash, Prelim-Midterm-Prefinal-Final installments) with downpayment gates.</li>\n<li><strong>Statements of Account (SOA):</strong> Instant PDF statement generation complete with balance ledgers, transaction history, and cryptographic validation hashes.</li>\n<li><strong>Cashier POS Interface:</strong> Streamlined counter interface for receiving cash, cheque, bank transfer, and online payments with instantaneous Official Receipt (OR) issuance.</li>\n<li><strong>Tuition Adjustments &amp; Vouchers:</strong> Formal adjustment requests and bulk tuition credit/debit spreadsheet imports with approval verification.</li>\n<li><strong>Financial Analytics &amp; Exports:</strong> Daily collection logs, aging balances, and student accounts exportable to Microsoft Excel and PDF.</li>\n</ul>\n<h3>6. Purpose-Built Workspaces</h3>\n<ul>\n<li><strong>Administrative Workspace (Filament 5):</strong> Unified management panel for registrars, deans, finance officers, and system administrators with role-scoped navigation and widgets.</li>\n<li><strong>Faculty Portal (Inertia 3 + React 19):</strong> Modern, responsive portal for teaching staff to manage assigned classes, mark attendance, post announcements, receive student assignments, and encode grades.</li>\n<li><strong>Student Portal (Inertia 3 + React 19):</strong> Mobile-first progressive web application for students to view weekly timetables, track tuition balances, download SOAs, view grade cards, access digital IDs, and receive push notifications.</li>\n</ul>\n<h3>7. Bundled Specialized Modules</h3>\n<ul>\n<li><strong>Announcements Module:</strong> School-wide, role-targeted, and department-specific bulletin board with banner render hooks.</li>\n<li><strong>Cashiering Module:</strong> Dedicated cashier register workflow with daily drawer balancing and transaction reconciliation.</li>\n<li><strong>Inventory &amp; Asset Management:</strong> Campus equipment ledger, room tracking, asset amortization, supplier directory, and custodian assignments.</li>\n<li><strong>Library Management System:</strong> Book cataloging, ISBN lookup, borrowing/returning ledger, overdue fines, and digital research paper archives.</li>\n<li><strong>Notification Center:</strong> Template-driven transactional messaging across email, in-app notifications, and batch broadcast queues.</li>\n<li><strong>Student Medical Records:</strong> Confidential clinic visit notes, student health profiles, medical clearances, and prescription logs with HIPAA-grade privacy isolation.</li>\n</ul>\n<h3>8. Security, AI &amp; Integrations</h3>\n<ul>\n<li><strong>Authentication:</strong> Passwordless WebAuthn passkeys, TOTP 2FA apps, email OTP, magic links, and Google/Microsoft OAuth via Socialite.</li>\n<li><strong>Role-Based Access Control (RBAC):</strong> Over 30 granular roles governed by Filament Shield and spatie/laravel-permission with model policy enforcement.</li>\n<li><strong>Observability:</strong> Integrated developer tools including Laralyze, Laravel Pulse, Telescope, Horizon queue monitors, and automated log retention cleanup.</li>\n<li><strong>Model Context Protocol (MCP) Server:</strong> Standardized MCP endpoint allowing AI agents (Claude Desktop, Delta, Cursor) to safely read and operate school records via authorized tools.</li>\n<li><strong>Gotenberg PDF Engine:</strong> High-performance, vector-crisp server-side document rendering powered by headless Chromium.</li>\n</ul>\n"
