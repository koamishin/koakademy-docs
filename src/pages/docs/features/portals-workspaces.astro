import DocsLayout from "@/layouts/DocsLayout.astro"

const html =
  "<p>Koakademy provides three distinct, role-optimized user interfaces rather than a single monolithic portal. Each workspace is tailored to the workflows, device form factors, and security needs of its intended audience.</p>\n<hr>\n<h2>1. Administrative Workspace (<code>/admin</code>)</h2>\n<p>Built on <strong>Filament 5</strong>, the Administrative Workspace is the mission-control center for School Administrators, Registrars, Department Chairs, Cashiers, and System Maintainers.</p>\n<pre><code>┌────────────────────────────────────────────────────────┐\n│ [LOGO] Koakademy Admin         [Org Switcher: Main]    │\n├───────────────┬────────────────────────────────────────┤\n│ Navigation    │ Dashboard                              │\n│ • Dashboard   │ ┌────────────┐┌────────────┐┌─────────┐│\n│ • Academic    │ │ Total Enr. ││ Outstanding││ Classes ││\n│ • Students    │ │ 4,821      ││ ₱1.2M      ││ 246     ││\n│ • Enrollment  │ └────────────┘└────────────┘└─────────┘│\n│ • Finance     │ Quick Actions                          │\n│ • Faculty     │ [ + Enroll Student ] [ + New Section ] │\n│ • Settings    │                                        │\n│ • Modules     │ Recent Registrations Table             │\n└───────────────┴────────────────────────────────────────┘\n</code></pre>\n<h3>Key Capabilities</h3>\n<ul>\n<li><strong>Role-Scoped Navigation:</strong> Over 30 granular roles (governed by Filament Shield) ensure registrars only see academic records, cashiers only see billing/collections, and system admins see infrastructure tools.</li>\n<li><strong>Organization Switcher:</strong> Instantly switch between branch campuses or school divisions without logging out.</li>\n<li><strong>Bulk Spreadsheet Tools:</strong> Import students, curricula, faculty loading sheets, and tuition adjustments directly from Excel templates.</li>\n<li><strong>Audit Log Inspection:</strong> Full chain-of-custody tracking showing who edited records, with IP addresses and before/after JSON diffs.</li>\n</ul>\n<hr>\n<h2>2. Faculty Portal (<code>/faculty</code>)</h2>\n<p>Built with <strong>Inertia 3 and React 19</strong>, the Faculty Portal provides teaching staff with a fast, modern single-page application for managing their classroom duties.</p>\n<pre><code>┌────────────────────────────────────────────────────────┐\n│ Koakademy Faculty       [AY 2026-2027, 1st Sem] [User] │\n├────────────────────────────────────────────────────────┤\n│ My Classes                                             │\n│ ┌───────────────────────┐  ┌─────────────────────────┐ │\n│ │ CS 101 - Section A    │  │ IT 204 - Section B       │ │\n│ │ MWF 8:00 AM - Room 101│  │ TTh 1:00 PM - Lab 302    │ │\n│ │ Enrolled: 38/40       │  │ Enrolled: 32/35          │ │\n│ │ [ Attendance ] [Grade]│  │ [ Attendance ] [Grade]   │ │\n│ └───────────────────────┘  └─────────────────────────┘ │\n│                                                        │\n│ Action Center                                          │\n│ • 4 Pending assignment submissions in IT 204           │\n│ • Midterm grading deadline in 3 days                   │\n└────────────────────────────────────────────────────────┘\n</code></pre>\n<h3>Key Capabilities</h3>\n<ul>\n<li><strong>Interactive Attendance Sheet:</strong> Mark students Present, Late, Absent, or Excused with a single tap. Summarizes attendance percentages and flags attendance risks automatically.</li>\n<li><strong>Gradebook &amp; Finalization:</strong> Enter prelim, midterm, and final marks with auto-calculated weighted averages. One-click submission locks grades and notifies department chairs.</li>\n<li><strong>Class Feed &amp; Announcements:</strong> Post lecture notes, homework guidelines, and syllabus updates directly to enrolled students.</li>\n<li><strong>Student Submission Ingestion:</strong> Accept digital assignments, track late submissions, and return teacher feedback.</li>\n</ul>\n<hr>\n<h2>3. Student Portal (<code>/student</code>)</h2>\n<p>Built with <strong>Inertia 3, React 19, and Tailwind CSS 4</strong>, the Student Portal is a responsive, mobile-first progressive web application (PWA) designed for students on smartphones and tablets.</p>\n<pre><code>┌──────────────────────────────────────┐\n│  JUAN DELA CRUZ           [ID CARD]  │\n│  BS Information Technology           │\n├──────────────────────────────────────┤\n│  TODAY&#39;S SCHEDULE                    │\n│  ┌─────────────────────────────────┐ │\n│  │ CS 101 - Introduction to CS     │ │\n│  │ 8:00 AM - 10:00 AM  •  Room 101 │ │\n│  └─────────────────────────────────┘ │\n│  ┌─────────────────────────────────┐ │\n│  │ IT 204 - Web Systems Lab        │ │\n│  │ 1:00 PM - 4:00 PM  •  Lab 302   │ │\n│  └─────────────────────────────────┘ │\n│                                      │\n│  FINANCIAL OVERVIEW                  │\n│  Outstanding Balance: ₱4,500.00      │\n│  Next Due Date: Oct 25 (Midterm)     │\n│  [ View Full Statement ]             │\n│                                      │\n│  QUICK ACCESS                        │\n│  [ Grades ] [ Timetable ] [ Clearance│\n└──────────────────────────────────────┘\n</code></pre>\n<h3>Key Capabilities</h3>\n<ul>\n<li><strong>Visual Timetable:</strong> A clear, color-coded weekly schedule showing start/end times, room locations, and professor names.</li>\n<li><strong>Financial Account Overview:</strong> Live ledger showing assessed tuition, posted payments, current balances, and downloadable Statement of Account PDFs.</li>\n<li><strong>Academic Grade Cards:</strong> Real-time visibility into midterm and final grades as soon as they are approved by the registrar.</li>\n<li><strong>Digital ID Card:</strong> Instant access to the mobile student ID with QR verification token for campus gate entry and library borrowing.</li>\n<li><strong>Clearance Tracker:</strong> Live departmental clearance status highlighting any active library, cashier, or departmental holds.</li>\n</ul>\n"
