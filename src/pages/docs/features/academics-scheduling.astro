import DocsLayout from "@/layouts/DocsLayout.astro"

const html =
  "<p>Koakademy provides an academic scheduling and curriculum engine designed to handle diverse institutional models—from secondary K-12 Senior High School tracks to multi-tiered collegiate degree programs and technical certificate courses.</p>\n<hr>\n<h2>Academic Hierarchy</h2>\n<pre><code>┌────────────────────────────────────────────────────────┐\n│                        School                          │\n└───────────────────────────┬────────────────────────────┘\n                            │\n              ┌─────────────┴─────────────┐\n              ▼                           ▼\n┌───────────────────────────┐ ┌───────────────────────────┐\n│     Basic Education       │ │     Higher Education      │\n│  (Junior &amp; Senior High)   │ │  (Colleges &amp; Departments) │\n└─────────────┬─────────────┘ └─────────────┬─────────────┘\n              │                             │\n       ┌──────┴──────┐               ┌──────┴──────┐\n       ▼             ▼               ▼             ▼\n┌─────────────┐┌─────────────┐ ┌─────────────┐┌─────────────┐\n│  SHS Track  ││ SHS Strand  │ │  Department ││   Program   │\n│ (e.g. TVL)  ││ (e.g. ICT)  │ │ (e.g. CITE) ││  (e.g. BSIT)│\n└──────┬──────┘└──────┬──────┘ └──────┬──────┘└──────┬──────┘\n       │              │               │              │\n       └──────┬───────┘               └──────┬───────┘\n              ▼                              ▼\n┌───────────────────────────┐ ┌───────────────────────────┐\n│     Strand Curriculum     │ │     Degree Curriculum     │\n└─────────────┬─────────────┘ └─────────────┬─────────────┘\n              │                             │\n              └──────────────┬──────────────┘\n                             ▼\n┌────────────────────────────────────────────────────────┐\n│                        Subjects                        │\n│   (Lecture Units, Lab Units, Hours, Pre/Co-reqs)       │\n└────────────────────────────┬───────────────────────────┘\n                             ▼\n┌────────────────────────────────────────────────────────┐\n│                     Class Offerings                    │\n│   (Sections, Room Allocation, Timetable, Faculty Load) │\n└────────────────────────────────────────────────────────┘\n</code></pre>\n<hr>\n<h2>Programs, Curricula &amp; Tracks</h2>\n<h3>Higher Education Degree Programs</h3>\n<p>Collegiate curricula in Koakademy are structured around academic departments and regulatory program standards:</p>\n<ul>\n<li><strong>Credit Units &amp; Clock Hours:</strong> Each subject explicitly differentiates between lecture credit units, laboratory credit units, lecture contact hours, and laboratory contact hours.</li>\n<li><strong>Year Level &amp; Term Mapping:</strong> Subjects are organized by year level (1st through 5th Year) and academic term (Semester, Trimester, or Summer Session).</li>\n<li><strong>Prerequisite Chains:</strong> Enforces linear or branched prerequisite requirements. A student cannot enroll in <em>Data Structures and Algorithms</em> without successfully passing <em>Computer Programming 2</em>.</li>\n<li><strong>Co-requisite Bundling:</strong> Enforces simultaneous enrollment in linked courses (e.g., enrolling in <em>Organic Chemistry Lecture</em> mandates simultaneous enrollment in <em>Organic Chemistry Laboratory</em>).</li>\n<li><strong>Major Specializations:</strong> Programs can define common core foundations followed by specialized major tracks in later years.</li>\n</ul>\n<h3>Senior High School (SHS) Tracks &amp; Strands</h3>\n<p>Koakademy natively implements the Department of Education (DepEd) K-12 Senior High School framework:</p>\n<ul>\n<li><strong>Academic Track:</strong> STEM (Science, Technology, Engineering, and Mathematics), ABM (Accountancy, Business, and Management), HUMSS (Humanities and Social Sciences), and GAS (General Academic Strand).</li>\n<li><strong>TVL Track:</strong> Technical-Vocational-Livelihood specializations, including Information and Communications Technology (ICT), Home Economics (HE), and Agri-Fishery Arts.</li>\n<li><strong>Subject Classifications:</strong> Distinguishes between <strong>Core Subjects</strong> (common to all SHS students), <strong>Applied Subjects</strong> (contextualized across tracks), and <strong>Specialized Subjects</strong> (exclusive to a chosen strand).</li>\n</ul>\n<hr>\n<h2>Timetable Scheduling &amp; Automated Conflict Detection</h2>\n<p>Koakademy replaces manual timetable spreadsheets with an interactive visual scheduler (<code>Timetable.php</code> and <code>AdministratorSchedulingAnalyticsController</code>).</p>\n<pre><code>┌──────┬──────────────────────┬──────────────────────┬──────────────────────┐\n│ Time │      Room 101        │      Lab 302         │      Gymnasium       │\n├──────┼──────────────────────┼──────────────────────┼──────────────────────┤\n│ 8:00 │ BSIT 1-A (Prof. Cruz)│ BSCS 2-B (Prof. Lim) │                      │\n│ 9:00 │ CS 101 Lecture       │ IT 204 Web Lab       │                      │\n├──────┼──────────────────────┼──────────────────────┼──────────────────────┤\n│10:00 │ [ CONFLICT BLOCKED ] │                      │ PE 101 (Prof. Santos)│\n│11:00 │ Room Already Booked  │                      │ Section 1-A &amp; 1-B    │\n└──────┴──────────────────────┴──────────────────────┴──────────────────────┘\n</code></pre>\n<h3>Automated Conflict Prevention</h3>\n<p>When an administrator or department chair assigns a class schedule, the system performs instantaneous constraint checks across three dimensions:</p>\n<ol>\n<li><strong>Room Collisions:</strong> Prevents scheduling two classes in the same physical or virtual room at overlapping times on identical days.</li>\n<li><strong>Faculty Overlapping Loads:</strong> Prevents assigning a professor to teach two distinct classes at the same time, calculating real-time faculty teaching units against institutional maximum overload caps.</li>\n<li><strong>Student Section Clashes:</strong> Validates that mandatory subjects assigned to a block section do not overlap, guaranteeing students a friction-free schedule.</li>\n</ol>\n<h3>Facilities &amp; Room Capacity</h3>\n<ul>\n<li><strong>Room Types:</strong> Classrooms, lecture halls, computer laboratories, science laboratories, drawing studios, and audio-visual rooms.</li>\n<li><strong>Capacity Gates:</strong> Prevents class section enrollments from exceeding the physical seating capacity of the assigned classroom.</li>\n</ul>\n<hr>\n<h2>Schedule Changes &amp; Student Notifications</h2>\n<p>In live operations, room reassignments, faculty substitutions, and class schedule adjustments are inevitable:</p>\n<ul>\n<li><strong>Schedule Change Log (<code>ClassScheduleChange</code>):</strong> Every timetable modification is recorded with the previous schedule, new schedule, authorized reason, and acting user.</li>\n<li><strong>Automated Student Broadcasts (<code>ClassScheduleChangeStudentNotification</code>):</strong> When a schedule change is approved, affected students receive immediate in-app notifications, mobile alerts, and updated timetable views.</li>\n<li><strong>Calendar Synchronization:</strong> Students and faculty can subscribe to live iCal calendar feeds or sync their schedules directly with Google Calendar. Schedule changes update in personal calendars automatically.</li>\n</ul>\n"
