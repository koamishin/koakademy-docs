import DocsLayout from "@/layouts/DocsLayout.astro"

const html =
  '<p>Koakademy integrates modern artificial intelligence natively through two distinct channels: an in-app <strong>Staff AI Assistant</strong> and an official <strong>Model Context Protocol (MCP) Server</strong> that connects the school database directly to external AI coding and workflow agents.</p>\n<hr>\n<h2>1. Staff AI Assistant</h2>\n<p>Located within the Administrative Workspace (<code>AiAssistant.php</code> and <code>AdministratorAiController</code>), the assistant provides natural language query access to institutional records:</p>\n<pre><code>┌────────────────────────────────────────────────────────┐\n│  Koakademy Staff AI Assistant                          │\n├────────────────────────────────────────────────────────┤\n│  User: How many students are officially enrolled in    │\n│        BSIT 3rd Year for the current semester?         │\n│                                                        │\n│  Assistant: Currently, there are 142 students          │\n│             officially enrolled across 4 sections:     │\n│             • Section 3-A: 36 students                 │\n│             • Section 3-B: 35 students                 │\n│             • Section 3-C: 36 students                 │\n│             • Section 3-D: 35 students                 │\n│                                                        │\n│             Total assessed tuition for this cohort     │\n│             is ₱2,130,000.00 with ₱1,450,000 collected.│\n└────────────────────────────────────────────────────────┘\n</code></pre>\n<h3>Capabilities</h3>\n<ul>\n<li><strong>Enrollment Analytics:</strong> Query enrollment counts, capacity bottlenecks, and registration conversion rates in natural language.</li>\n<li><strong>Financial Summaries:</strong> Inquire about daily collection totals, delinquent balances, and fee breakdown statistics.</li>\n<li><strong>Academic Scheduling:</strong> Quickly locate available classrooms or check professor schedules without navigating multiple timetable menus.</li>\n<li><strong>Privacy Protections:</strong> The AI assistant strictly honors the asking user&#39;s RBAC permissions. A department chair cannot query financial ledgers outside their authorized scope.</li>\n</ul>\n<hr>\n<h2>2. Model Context Protocol (MCP) Integration</h2>\n<p>Koakademy implements the open <strong>Model Context Protocol (MCP)</strong> specification (<code>McpServer.php</code> and <code>routes/ai.php</code>). This allows authorized AI agents (such as Claude Desktop, Delta, Cursor, and enterprise LLM orchestrators) to interact with school operations through safe, typed tools.</p>\n<pre><code>┌──────────────────┐          MCP Protocol          ┌──────────────────┐\n│  AI Client /     │ ─────────────────────────────▶ │ Koakademy        │\n│  LLM Agent       │ ◀───────────────────────────── │ MCP Server       │\n│  (Claude, Cursor)│          JSON-RPC 2.0          │ (/api/ai/mcp)    │\n└──────────────────┘                                └────────┬─────────┘\n                                                             │\n                                                             ▼\n                                                    ┌──────────────────┐\n                                                    │ Authorized Tools │\n                                                    │ &amp; Entity Models  │\n                                                    └──────────────────┘\n</code></pre>\n<h3>Supported MCP Tools</h3>\n<ul>\n<li><strong>Student Lookup (<code>get_student_profile</code>):</strong> Retrieve verified student details, contact info, and current enrollment status by student number or email.</li>\n<li><strong>Enrollment Verification (<code>verify_enrollment</code>):</strong> Check whether a student has met all prerequisites, cleared holds, and achieved official enrolled status.</li>\n<li><strong>Class Timetable Lookup (<code>get_class_schedule</code>):</strong> Fetch weekly class schedules, meeting times, room locations, and instructor details.</li>\n<li><strong>Academic Program Inquiries (<code>get_curriculum</code>):</strong> Inspect program courses, prerequisite requirements, and credit unit distributions.</li>\n<li><strong>Clearance Status Check (<code>get_student_clearance</code>):</strong> Inspect active departmental clearance holds and resolution steps.</li>\n</ul>\n<p>For complete tool schemas, configuration steps, and security guidelines, see the <a href="/api/mcp">MCP API Reference</a>.</p>\n'
---

<DocsLayout
  title="AI Assistant & MCP Server"
  path="/docs/features/ai-mcp"
  description="Native AI capabilities, staff inquiry assistants, and Model Context Protocol (MCP) tool integration for intelligent agent workflows."
>
  <Fragment set:html={html} />
</DocsLayout>
