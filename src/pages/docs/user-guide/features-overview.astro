    <thead>
      <tr>
        <th>Area</th>
        <th>What it covers</th>
        <th>Where</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Academic records</td>
        <td>Students, faculty, courses, departments, rooms, senior high strands</td>
        <td>Admin panel</td>
      </tr>
      <tr>
        <td>Classes and scheduling</td>
        <td>Sections, subject assignments, capacity, timetables with conflict detection</td>
        <td>Admin panel and Admin workspace</td>
      </tr>
      <tr>
        <td>Enrollment</td>
        <td>Applications, verification pipeline, class enrollment, reports and analytics</td>
        <td>Admin workspace</td>
      </tr>
      <tr>
        <td>Grading</td>
        <td>Point/percent scales, passing rules, GWA exclusions, finalize and verify workflow</td>
