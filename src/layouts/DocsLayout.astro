---
import "@/styles/docs.css"
import Layout from "@/layouts/main.astro"
import Seal from "@/components/Seal.astro"
import {
  treeFor,
  flattenDocs,
  groupOf,
  sectionForPath,
  type DocSection,
} from "@/data/docs"

interface Props {
  title: string
  description?: string
  /** Current route path, e.g. /api/student-verification */
  path: string
  /** Which documentation section this page belongs to. */
  section?: DocSection
}

const { title, description = "", path, section: sectionProp } = Astro.props
const section: DocSection = sectionProp ?? sectionForPath(path)
const tree = treeFor(section)
const flat = flattenDocs(tree)
const idx = flat.findIndex((d) => d.href === path)
const prev = idx > 0 ? flat[idx - 1] : null
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null
const current = groupOf(path)
const sectionLabel =
  section === "api"
    ? "API reference"
    : section === "dev"
      ? "Developers"
      : "Docs"
const homeHref =
  section === "api" ? "/api" : section === "dev" ? "/dev" : "/docs"
const groupLabel = current?.group.label ?? sectionLabel
const eyebrow = current ? `${sectionLabel} · ${groupLabel}` : sectionLabel
const github = "https://github.com/yukazakiri/koakademy"
const site = Astro.site ?? new URL("https://koakademy.koamishin.com/")
const siteUrl = site.href.endsWith("/") ? site.href : `${site.href}/`
const absoluteUrl = (pagePath: string) =>
  new URL(
    pagePath === "/" ? "" : `${pagePath.replace(/^\/+|\/+$/g, "")}/`,
    siteUrl
  ).href
const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: sectionLabel, path: homeHref },
  ...(path === homeHref ? [] : [{ name: title, path }]),
]
const structuredData = [
  {
    "@type": "TechArticle",
    "@id": `${absoluteUrl(path)}#article`,
    headline: title,
    description: description || `KoAkademy documentation — ${sectionLabel}`,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    author: { "@type": "Organization", name: "KoAkademy" },
    publisher: { "@type": "Organization", name: "KoAkademy" },
    inLanguage: "en",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: absoluteUrl(item.path),
    })),
  },
]

const tabs = [
  { id: "docs" as DocSection, label: "Docs", href: "/docs" },
  { id: "api" as DocSection, label: "API reference", href: "/api" },
  { id: "dev" as DocSection, label: "Developers", href: "/dev" },
]
---

<Layout
  title={`${title} — KoAkademy docs`}
  description={description || `KoAkademy documentation — ${sectionLabel}`}
  canonicalPath={path}
  pageType="article"
  structuredData={structuredData}
>
  <header
    class="site-nav sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md"
  >
    <nav
      class="mx-auto flex h-16 max-w-[90rem] items-center justify-between px-6"
      aria-label="Docs header"
    >
      <a href="/" class="flex items-center gap-2.5">
        <Seal size={28} class="text-ink" />
        <span class="font-display text-[19px] font-medium tracking-[-0.01em]"
          >KoAkademy</span
        >
        <span
          class="ml-1 rounded border border-line px-1.5 py-px font-mono text-[9.5px] tracking-[0.18em] text-ink-soft uppercase"
          >{sectionLabel}</span
        >
      </a>
      <div class="flex items-center gap-2.5">
        <a
          href={github}
          target="_blank"
          rel="noreferrer"
          class="hidden items-center gap-2 rounded-lg border border-line px-3.5 py-2.5 text-[13.5px] font-medium text-ink transition-colors hover:border-ink/30 hover:bg-paper-2 sm:inline-flex"
        >
          GitHub
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-2.5 text-[13.5px] font-medium text-paper transition hover:-translate-y-px hover:bg-ink/85"
        >
          Back to home
        </a>
      </div>
    </nav>

    <div class="border-t border-line">
      <nav
        class="doc-tabs mx-auto flex max-w-[90rem] items-center justify-center gap-1 px-6"
        aria-label="Documentation sections"
      >
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={["doc-tab", { "doc-tab-active": section === tab.id }]}
              aria-current={section === tab.id ? "page" : undefined}
            >
              {tab.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main id="top" class="mx-auto flex w-full max-w-[90rem] gap-12 px-6">
    <aside
      class="doc-sidebar hidden w-64 shrink-0 py-14 pr-4 lg:block"
      aria-label={`${sectionLabel} sections`}
    >
      <a
        href={homeHref}
        class:list={[
          "mb-4 block border-l-2 border-transparent pl-3 font-mono text-[11px] tracking-[0.2em] text-ink-soft uppercase transition-colors hover:text-ink",
          { "border-l-brass! text-ink!": path === homeHref },
        ]}>{sectionLabel} home</a
      >
      {
        tree.map((group) => (
          <div>
            <p class="doc-side-label">{group.label}</p>
            {group.links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "doc-side-link",
                  { "is-active": link.href === path },
                ]}
              >
                {link.title}
              </a>
            ))}
          </div>
        ))
      }
    </aside>

    <div class="min-w-0 flex-1 py-12 md:py-16">
      <a
        href={homeHref}
        class="mb-6 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[0.18em] text-ink-soft uppercase transition-colors hover:text-ink lg:hidden"
      >
        ← {sectionLabel} home
      </a>

      <p
        class="font-mono text-[11px] font-medium tracking-[0.24em] text-brass-deep uppercase"
      >
        {eyebrow}
      </p>
      <h1 class="doc-title">{title}</h1>
      {description && <p class="doc-lede">{description}</p>}

      <div class="mt-8 border-t border-line pt-8">
        <div class="doc-prose">
          <slot />
        </div>
      </div>

      <nav class="doc-pager" aria-label="Documentation navigation">
        {
          prev ? (
            <a href={prev.href}>
              <p class="doc-pager-label">← Previous</p>
              <p class="doc-pager-title">{prev.title}</p>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={next.href} class="doc-pager-next">
              <p class="doc-pager-label">Next →</p>
              <p class="doc-pager-title">{next.title}</p>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </main>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-[90rem] flex-col gap-3 px-6 py-8 text-[13px] text-ink-soft sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© 2026 KoAkademy · GNU AGPL-3.0-or-later</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <a href="/docs" class="transition-colors hover:text-ink">Docs</a>
        <a href="/api" class="transition-colors hover:text-ink">API reference</a
        >
        <a href="/dev" class="transition-colors hover:text-ink">Developers</a>
        <a
          href={github}
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-ink">GitHub</a
        >
        <a
          href="https://yukazakiri.github.io/koakademy"
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-ink">Official docs</a
        >
      </div>
    </div>
  </footer>

  <script>
    import { copyToClipboard, flashCopied } from "@/lib/clipboard"

    function attachCopyButtons() {
      document
        .querySelectorAll("pre")
        .forEach((/** @type {HTMLPreElement} */ pre) => {
          if (pre.dataset.copyButton) return
          /** @type {HTMLElement | null} */
          const code = pre.querySelector("code")
          // Only enhance code blocks; a button appended to a pre without a code
          // child would be included in the copied text.
          if (!code) return
          pre.dataset.copyButton = "true"
          pre.classList.add("copy-zone")

          const btn = document.createElement("button")
          btn.type = "button"
          btn.className = "copy-btn"
          btn.textContent = "Copy"
          btn.setAttribute("aria-label", "Copy code block")
          btn.addEventListener("click", async () => {
            if (await copyToClipboard(code.innerText)) flashCopied(btn)
          })
          pre.appendChild(btn)
        })
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", attachCopyButtons)
    } else {
      attachCopyButtons()
    }
  </script>
</Layout>
