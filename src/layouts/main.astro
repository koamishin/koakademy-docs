---
import "@/styles/global.css"

export interface Props {
  title?: string
  description?: string
  /** Canonical URL path (e.g. /docs/self-hosting/installation). Defaults to Astro.url.pathname. */
  canonicalPath?: string
  /** Comma-separated keywords for SEO. */
  keywords?: string
  /** Open Graph / Twitter image path (e.g. /og-default.png). */
  image?: string
  /** Article published date (ISO 8601). */
  pubDate?: string
  /** Article last modified date (ISO 8601). */
  modDate?: string
  /** Whether to allow indexing (default true). */
  index?: boolean
}

const {
  title = "KoAkademy — The school’s system of record, owned by the school",
  description = "KoAkademy is an open-source, self-hosted academic management platform — enrollment, academics, finance, and three portals — built with Laravel, React, and PostgreSQL. No per-student pricing. No feature gates.",
  canonicalPath,
  keywords = "KoAkademy, open-source school management, academic management software, self-hosted LMS, enrollment system, Laravel school platform, school administration, open source education platform",
  image = "/favicon.svg",
  pubDate,
  modDate,
  index = true,
} = Astro.props

const SITE = "https://koakademy.org"
const canonical = canonicalPath
  ? `${SITE}${canonicalPath}`
  : new URL(Astro.url.pathname, SITE).href
const robotsContent = index ? "index, follow" : "noindex, nofollow"
const ogImage = image.startsWith("http") ? image : `${SITE}${image}`

// JSON-LD structured data built in frontmatter so <script is:inline> works.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "KoAkademy",
      url: SITE,
      logo: `${SITE}/favicon.svg`,
      description:
        "Open-source, self-hosted academic management platform built with Laravel, React, and PostgreSQL.",
      sameAs: ["https://github.com/yukazakiri/koakademy"],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "KoAkademy",
      description:
        "The school's system of record, owned by the school — enrollment, academics, finance, and three portals.",
      publisher: { "@id": `${SITE}/#organization` },
      inLanguage: "en-US",
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
}
const jsonLdRaw = JSON.stringify(jsonLd)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="KoAkademy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {pubDate && <meta property="article:published_time" content={pubDate} />}
    {modDate && <meta property="article:modified_time" content={modDate} />}

    <!-- JSON-LD Structured Data: Organization + WebSite -->
    <script type="application/ld+json" set:html={jsonLdRaw}></script>

    <script is:inline>
      ;(function () {
        document.documentElement.classList.add("js")
        // Apply the saved theme (or the OS preference) before first paint so
        // there is no flash of the wrong color scheme.
        var dark = false
        var stored = null
        try {
          stored = localStorage.getItem("theme")
        } catch (e) {
          stored = null
        }
        dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches
        document.documentElement.classList.toggle("dark", dark)
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) meta.setAttribute("content", dark ? "#101a14" : "#f5f3ec")
      })()
    </script>
  </head>
  <body>
    <a
      href="#top"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2.5 focus:text-sm focus:font-medium focus:text-paper"
      >Skip to content</a
    >
    <slot />

    <script>
      import hljs from "highlight.js/lib/common"
      import powershell from "highlight.js/lib/languages/powershell"
      hljs.registerLanguage("powershell", powershell)
      hljs.configure({ ignoreUnescapedHTML: true })

      function highlightBlocks() {
        document
          .querySelectorAll("pre code")
          .forEach((/** @type {HTMLElement} */ el) => {
            try {
              hljs.highlightElement(el)
            } catch {
              // Leave the block plain; highlighting is progressive enhancement.
            }
          })
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", highlightBlocks)
      } else {
        highlightBlocks()
      }

      // --- Theme toggle (persists to localStorage, falls back to OS) ---
      const themeColorMeta = document.querySelector('meta[name="theme-color"]')

      function syncThemeUI() {
        const dark = document.documentElement.classList.contains("dark")
        document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(dark))
        })
        if (themeColorMeta) {
          themeColorMeta.setAttribute("content", dark ? "#101a14" : "#f5f3ec")
        }
      }

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return
        const toggle = event.target.closest("[data-theme-toggle]")
        if (!toggle) return
        const dark = document.documentElement.classList.toggle("dark")
        try {
          localStorage.setItem("theme", dark ? "dark" : "light")
        } catch {
          // Storage unavailable (e.g. private mode) — theme won't persist.
        }
        syncThemeUI()
      })

      // Follow OS theme changes only while the user has no explicit choice.
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (event) => {
          let stored = null
          try {
            stored = localStorage.getItem("theme")
          } catch {
            stored = null
          }
          if (stored) return
          document.documentElement.classList.toggle("dark", event.matches)
          syncThemeUI()
        })

      syncThemeUI()
    </script>
  </body>
</html>
